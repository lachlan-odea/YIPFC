# Copy to .env and fill in to share the pool across your pod.
# Leave blank to run in single-device mode (data stays in this browser).
#
# Values come from the Firebase console: Project settings > General >
# Your apps > SDK setup and configuration. These are public web config
# values, not secrets; access is governed by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional, defaults to <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
